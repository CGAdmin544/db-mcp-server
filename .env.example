# ============ 多数据库 MCP 服务器配置模板 ============
# 复制本文件为 .env 后填写真实值：cp .env.example .env
#
# 连接方式二选一（推荐方式一，最灵活）：
#   方式 A：直接给出完整 SQLAlchemy URL（DATABASE_URL），其余变量可省略；
#   方式 B：给出 DB_TYPE + 拆分字段（DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME）。

# -------------------------------------------------------------------
# 方式 A：完整 SQLAlchemy URL（优先级最高，设置后忽略下方 DB_* 拆分字段）
# 示例：
#   Oracle      : oracle+oracledb://user:pw@host:1521/?service_name=ORCL
#   SQL Server  : mssql+pyodbc://user:pw@host:1433/dbname?driver=ODBC+Driver+17+for+SQL+Server
#   MySQL       : mysql+pymysql://user:pw@host:3306/dbname
#   PostgreSQL  : postgresql+psycopg2://user:pw@host:5432/dbname
#   SQLite      : sqlite:///C:/path/to/app.db
# DATABASE_URL=

# -------------------------------------------------------------------
# 方式 B：拆分字段（DB_TYPE 决定使用的数据库方言）
# DB_TYPE 可选值：oracle / sqlserver / mysql / postgres / sqlite
DB_TYPE=oracle

# 数据库账号与地址
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=1521
DB_NAME=your_service_name_or_dbname

# SQL Server 专用：ODBC 驱动名（默认 ODBC Driver 17 for SQL Server）
# DB_ODBC_DRIVER=ODBC+Driver+17+for+SQL+Server

# ============ 访问模式 ============
# readonly  （默认）：禁止执行 INSERT/UPDATE/DELETE，仅允许查询
# readwrite：允许执行 DML 写操作
DB_MODE=readonly

# ============ Oracle 兼容（历史配置仍可继续用） ============
# 若只连接 Oracle，也可不写 DB_TYPE/DB_*，直接填下面的 ORACLE_* 变量。
# 同时配置了 DB_* 与 ORACLE_* 时，DB_* 优先。
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ORCLPDB1
ORACLE_MODE=readonly

# ============ 可选：Oracle 客户端库（thick 模式，仅 Oracle 11g 等老库需要） ============
# thin 模式（默认）无需本地 Oracle 客户端即可工作，但仅支持 Oracle 12.1+。
# 若目标库为 11g 等老版本，必须启用 thick 模式：安装 Oracle Instant Client 后填写其目录。
# 实测：Instant Client 11.2（64 位）配合 python-oracledb 4.x 可正常连接 11g 库。
# 示例（请改为你本机实际路径）：
# ORACLE_CLIENT_LIB_DIR=E:\A_DevTool\instantclient_11_2
