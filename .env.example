# ============ Oracle 数据库连接配置 ============
# 复制本文件为 .env 后填写真实值：cp .env.example .env

# 数据库账号
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password

# 数据库地址
ORACLE_HOST=localhost
ORACLE_PORT=1521

# 连接方式：Service Name（本项目使用，容器/多租户常用）
ORACLE_SERVICE_NAME=ORCLPDB1

# ============ 访问模式 ============
# readonly  （默认）：禁止执行 INSERT/UPDATE/DELETE，仅允许查询
# readwrite：允许执行 DML 写操作
ORACLE_MODE=readonly

# ============ 可选：Oracle 客户端库（thick 模式） ============
# thin 模式（默认）无需本地 Oracle 客户端即可工作，但仅支持 Oracle 12.1+ 数据库。
# 若目标库为 11g 等老版本，必须启用 thick 模式：安装 Oracle Instant Client 后填写其目录。
# 实测：Instant Client 11.2（64 位）配合 python-oracledb 4.x 可正常连接 11g 库。
# 示例（请改为你本机实际路径）：
# ORACLE_CLIENT_LIB_DIR=E:\A_DevTool\instantclient_11_2

# ============ 连接池配置（可选） ============
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1
